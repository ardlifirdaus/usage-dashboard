if not GITHUB_TOKEN:
    raise Exception("❌ GITHUB_TOKEN tidak ditemukan di environment variable!")

# Remote dengan autentikasi via token
remote_url = f"https://ardlifirdaus/usage-dashboard:{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}@github.com/ardlifirdaus/usage-dashboard.git"

